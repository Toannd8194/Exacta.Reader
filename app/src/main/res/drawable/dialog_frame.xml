<?xml version="1.0" encoding="utf-8"?>
<!-- Every popup of the app: white paper in a black frame, like the cards of the screens. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="20dp" android:insetRight="20dp" android:insetTop="24dp" android:insetBottom="24dp">
    <shape android:shape="rectangle">
        <solid android:color="@android:color/white" />
        <stroke android:width="2.5dp" android:color="@android:color/black" />
        <corners android:radius="12dp" />
        <padding android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp" />
    </shape>
</inset>
