<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- E-ink: white paper, black ink, no window animations, no action bar. -->
    <style name="Theme.Exacta" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="colorPrimary">@android:color/black</item>
        <item name="colorAccent">@android:color/black</item>
        <item name="alertDialogTheme">@style/Theme.Exacta.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Exacta.Dialog</item>
        <!-- Bitter everywhere, popups and toasts too. -->
        <item name="android:fontFamily">@font/bitter_ui</item>
        <item name="fontFamily">@font/bitter_ui</item>
    </style>

    <!-- Popups: framed in black, no animation, black buttons. -->
    <style name="Theme.Exacta.Dialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_frame</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="colorAccent">@android:color/black</item>
        <item name="android:backgroundDimAmount">0.15</item>
        <item name="android:fontFamily">@font/bitter_ui</item>
        <item name="fontFamily">@font/bitter_ui</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/black</item>
    </style>
</resources>
